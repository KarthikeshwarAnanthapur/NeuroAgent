# ================================
# NeuroAgent .gitignore
# ================================

# ----------------
# NEVER COMMIT
# ----------------

# Node dependencies
node_modules/
**/node_modules/

# Python caches
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/

# Build artifacts
dist/
**/dist/
build/
**/build/

# Environment variables / secrets
.env
.env.*
**/.env
**/.env.*
!.env.example

# IDE files
.vscode/
**/.vscode/
.idea/
**/.idea/

# OS files
*.swp
*.swo
.DS_Store
Thumbs.db

# ----------------
# DO NOT IGNORE
# ----------------
# EEG datasets and processed data are intentionally
# tracked through Git LFS:
#
# *.edf
# *.fif
# *.csv
# *.pth
# *.pt
# *.onnx